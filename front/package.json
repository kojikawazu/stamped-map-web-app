{
  "name": "stamped-map-web-app",
  "packageManager": "pnpm@10.28.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt prepare && prisma generate && nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "type-check": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:it": "vitest run --config vitest.config.it.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:seed": "tsx prisma/seed.ts",
    "db:push:test": "tsx prisma/push-test-db.ts",
    "db:setup:test": "pnpm db:push:test && pnpm db:seed"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^1.6.2",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.14.0",
    "nuxt": "^3.21.11",
    "pg": "^8.23.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue-sonner": "^1.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "h3": "1.15.11",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "mysql2@<3.23.1": "^3.23.1"
    }
  }
}
